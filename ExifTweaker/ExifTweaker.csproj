<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	<NoWarn></NoWarn>
	<ApplicationIcon>exif.ico</ApplicationIcon>
	<StartupObject>ExifTweaker.Program</StartupObject>
	<AssemblyVersion>1.0</AssemblyVersion>
	<FileVersion>1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="exif.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ExifLibrary">
      <HintPath>..\lib\ExifLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="exiftool.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>